PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_public_key
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_secret_key
# Required before storing Paystack secret keys for additional restaurants in Super Admin.
# Generate once with: npm run generate-encryption-key
PAYSTACK_CREDENTIALS_ENCRYPTION_KEY=replace_with_a_64_character_hex_key
# Required before customers can pay. Use a Paystack split code that sends the service fee to Instant Tech Solution.
PAYSTACK_SPLIT_CODE=SPL_replace_with_your_split_code
ADMIN_USERNAME=admin
# Use ADMIN_PASSWORD for quick local testing, or ADMIN_PASSWORD_HASH for stronger production setup.
ADMIN_PASSWORD=change_this_password
# ADMIN_PASSWORD_HASH=scrypt$replace_with_generated_hash
# HungerStation platform owner account. Use a unique password hash in Render.
SUPER_ADMIN_USERNAME=platform-owner
# SUPER_ADMIN_PASSWORD_HASH=scrypt$replace_with_generated_hash
# Optional default staff user. Useful for free demo deployments where temporary storage can reset.
STAFF_USERNAME=staff
STAFF_DISPLAY_NAME=Staff
# STAFF_PASSWORD_HASH=scrypt$replace_with_generated_hash
# Optional Home Food Vendor demo. It is created only when the username and password hash are set.
HOME_VENDOR_DEMO_NAME=HungerStation Home Food Demo
HOME_VENDOR_DEMO_ADMIN_USERNAME=vendor-demo
# Use a hash in Render. For local testing only, HOME_VENDOR_DEMO_ADMIN_PASSWORD is also supported.
# HOME_VENDOR_DEMO_ADMIN_PASSWORD_HASH=scrypt$replace_with_generated_hash
PORT=3000
STORAGE_ROOT=./data
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14
